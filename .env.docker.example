# Copy to .env.docker and replace every placeholder before starting.
POSTGRES_DB=mg_business
POSTGRES_USER=mg_business_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MG_FRONTEND_ORIGIN=http://localhost:5173
# Bind only to loopback by default. Do not set 0.0.0.0 without a secured reverse proxy/firewall.
MG_API_BIND_ADDRESS=127.0.0.1
MG_API_PORT=8080
