# Copy to /etc/nginx/sites-available/mg-business and replace the example domain.
# The backend listens only on loopback; Nginx is the only trusted proxy.
server {
    listen 80;
    listen [::]:80;
    server_name business.example.com;
    return 301 https://business.example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name business.example.com;
    # Reject unexpected Host headers instead of serving the tenant on arbitrary domains.
    if ($host != business.example.com) { return 444; }

    ssl_certificate /etc/letsencrypt/live/business.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/business.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:MGSSL:10m;
    ssl_session_tickets off;

    client_max_body_size 50m;
    # Bound idle client connections and slow header/body transfers.
    keepalive_timeout 15s;
    client_header_timeout 15s;
    client_body_timeout 30s;
    send_timeout 30s;

    # Limit concurrent connections per client IP at the edge.
    limit_conn mg_per_ip 30;

    location /api/ {
        # Smooth bursts while limiting sustained API request floods per IP.
        limit_req zone=mg_api_per_ip burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
