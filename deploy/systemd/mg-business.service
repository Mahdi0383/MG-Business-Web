[Unit]
Description=MG Business Web Platform
After=network.target
Wants=network.target

[Service]
Type=simple
User=mg-business
Group=mg-business
WorkingDirectory=/opt/mg-business
EnvironmentFile=/etc/mg-business/mg-business.env
ExecStart=/bin/sh /opt/mg-business/deploy/systemd/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/mg-business /var/backups/mg-business

[Install]
WantedBy=multi-user.target
