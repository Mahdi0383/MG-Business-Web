# Copy to /etc/mg-business/mg-business.env and replace every placeholder.
MG_ENV=production
MG_HOST=127.0.0.1
MG_PORT=8080
MG_PUBLIC_URL=https://business.example.com
MG_LICENSE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Generate with: python backup_manager.py --generate-key; store this key outside the server and backups.
MG_BACKUP_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_URLSAFE_BASE64_32_BYTE_KEY
MG_DATA_DIR=/var/lib/mg-business
MG_DB_PATH=/var/lib/mg-business/mg-business.sqlite3
MG_BACKUP_DIR=/var/backups/mg-business
MG_BACKUP_INTERVAL_HOURS=24
MG_BACKUP_RETENTION=14
# Trust only the local Nginx reverse proxy. Never add public client networks here.
MG_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Bound concurrent HTTP requests and slow-client socket occupancy.
MG_MAX_HTTP_WORKERS=64
MG_REQUEST_TIMEOUT_SECONDS=15
